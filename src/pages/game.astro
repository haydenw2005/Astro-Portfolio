---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Coastal Road Trip Game" description="A fun coastal road trip dodging game">
  <div id="game-container" class="w-full h-screen bg-gradient-to-b from-orange-300 via-yellow-200 to-green-300 overflow-hidden relative">
    <canvas id="gameCanvas" class="absolute inset-0"></canvas>
    
    <!-- Game UI -->
    <div id="game-ui" class="absolute top-4 left-4 text-white font-bold text-xl z-10">
      <div>Score: <span id="score">0</span></div>
      <div class="mt-2">Lives: <span id="lives">3</span></div>
    </div>
    
    <!-- Game Over Screen -->
    <div id="game-over" class="absolute inset-0 bg-black bg-opacity-75 flex items-center justify-center z-20 hidden">
      <div class="text-center text-white">
        <h2 class="text-4xl font-bold mb-4">Game Over!</h2>
        <p class="text-xl mb-4">Final Score: <span id="final-score">0</span></p>
        <button id="restart-btn" class="bg-blue-500 hover:bg-blue-600 px-6 py-3 rounded-lg font-bold">
          Play Again
        </button>
        <button id="home-btn" class="bg-gray-500 hover:bg-gray-600 px-6 py-3 rounded-lg font-bold ml-4">
          Go Home
        </button>
      </div>
    </div>
    
    <!-- Instructions -->
    <div id="instructions" class="absolute bottom-4 left-4 text-white text-sm z-10">
      <p>Desktop: Use ← → arrow keys</p>
      <p>Mobile: Swipe left/right</p>
      <p>Dodge obstacles, collect seals!</p>
    </div>
  </div>
</Layout>

<script>
  class CoastalRoadTripGame {
    constructor() {
      this.canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;
      this.ctx = this.canvas.getContext('2d')!;
      this.score = 0;
      this.lives = 3;
      this.gameRunning = true;
      this.gameSpeed = 2;
      
      // Game objects
      this.player = {
        x: 0,
        y: 0,
        width: 60,
        height: 80,
        speed: 8,
        targetX: 0, // For smooth movement
        moveSpeed: 0.15, // Interpolation speed
        bobOffset: 0 // For engine rumble animation
      };
      
      this.obstacles = [];
      this.seals = [];
      this.roadLines = [];
      this.oceanWaves = [];
      this.landscapeElements = [];
      this.crashAnimation = null;
      this.gameTime = 0;
      this.particles = [];
      
      // Touch controls
      this.touchStartX = 0;
      this.touchStartY = 0;
      
      this.init();
    }
    
    init() {
      this.resizeCanvas();
      this.setupEventListeners();
      this.setupPlayer();
      this.initRoadLines();
      this.gameLoop();
      
      // Spawn objects
      setInterval(() => this.spawnObstacle(), 2000);
      setInterval(() => this.spawnSeal(), 3000);
    }
    
    resizeCanvas() {
      this.canvas.width = window.innerWidth;
      this.canvas.height = window.innerHeight;
      this.setupPlayer();
    }
    
    setupPlayer() {
      this.player.x = this.canvas.width * 0.5 - this.player.width / 2;
      this.player.targetX = this.player.x;
      this.player.y = 100; // Move car to top of screen
    }
    
    initRoadLines() {
      for (let i = 0; i < 20; i++) {
        this.roadLines.push({
          x: this.canvas.width / 2 - 2,
          y: i * 50 - 1000, // Start lines higher up
          width: 4,
          height: 30
        });
      }
      
      // Initialize ocean waves
      this.oceanWaves = [];
      for (let i = 0; i < 15; i++) {
        this.oceanWaves.push({
          x: Math.random() * (this.canvas.width * 0.3),
          y: i * 40 - 600, // Start waves higher up
          amplitude: 10 + Math.random() * 15,
          frequency: 0.01 + Math.random() * 0.02
        });
      }
      
      // Initialize landscape elements
      this.landscapeElements = [];
      for (let i = 0; i < 10; i++) {
        this.landscapeElements.push({
          x: this.canvas.width * 0.7 + Math.random() * (this.canvas.width * 0.3),
          y: i * 80 - 800, // Start landscape elements higher up
          type: Math.random() > 0.5 ? 'tree' : 'hill',
          size: 20 + Math.random() * 40
        });
      }
    }
    
    setupEventListeners() {
      // Keyboard controls
      document.addEventListener('keydown', (e) => {
        if (!this.gameRunning) return;
        
        if (e.key === 'ArrowLeft' && this.player.targetX > this.canvas.width * 0.3 + 10) {
          this.player.targetX -= this.player.speed * 4;
        }
        if (e.key === 'ArrowRight' && this.player.targetX < this.canvas.width * 0.7 - this.player.width - 10) {
          this.player.targetX += this.player.speed * 4;
        }
      });
      
      // Touch controls
      this.canvas.addEventListener('touchstart', (e) => {
        e.preventDefault();
        this.touchStartX = e.touches[0].clientX;
        this.touchStartY = e.touches[0].clientY;
      });
      
      this.canvas.addEventListener('touchmove', (e) => {
        e.preventDefault();
      });
      
      this.canvas.addEventListener('touchend', (e) => {
        e.preventDefault();
        if (!this.gameRunning) return;
        
        const touchEndX = e.changedTouches[0].clientX;
        const touchEndY = e.changedTouches[0].clientY;
        const deltaX = touchEndX - this.touchStartX;
        const deltaY = touchEndY - this.touchStartY;
        
        // Only respond to horizontal swipes
        if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 30) {
          if (deltaX > 0 && this.player.targetX < this.canvas.width * 0.7 - this.player.width - 10) {
            this.player.targetX += this.player.speed * 8;
          } else if (deltaX < 0 && this.player.targetX > this.canvas.width * 0.3 + 10) {
            this.player.targetX -= this.player.speed * 8;
          }
        }
      });
      
      // Restart button
      document.getElementById('restart-btn')?.addEventListener('click', () => {
        this.restart();
      });
      
      // Home button
      document.getElementById('home-btn')?.addEventListener('click', () => {
        window.location.href = '/ilovemygirlfriend';
      });
      
      // Window resize
      window.addEventListener('resize', () => this.resizeCanvas());
    }
    
    spawnObstacle() {
      if (!this.gameRunning) return;
      
      const types = ['rock', 'car', 'cop'];
      const type = types[Math.floor(Math.random() * types.length)];
      const roadWidth = this.canvas.width * 0.4; // Road is 40% of screen width
      const roadStart = this.canvas.width * 0.3;
      const laneWidth = roadWidth / 3;
      const lane = Math.floor(Math.random() * 3);
      
      this.obstacles.push({
        x: roadStart + (lane * laneWidth) + (laneWidth - 50) / 2,
        y: this.canvas.height + 100,
        width: 50,
        height: 80,
        type: type,
        speed: this.gameSpeed + Math.random() * 2
      });
    }
    
    spawnSeal() {
      if (!this.gameRunning) return;
      
      const roadWidth = this.canvas.width * 0.4;
      const roadStart = this.canvas.width * 0.3;
      const laneWidth = roadWidth / 3;
      const lane = Math.floor(Math.random() * 3);
      
      this.seals.push({
        x: roadStart + (lane * laneWidth) + (laneWidth - 40) / 2,
        y: this.canvas.height + 60,
        width: 40,
        height: 40,
        speed: this.gameSpeed + 1
      });
    }
    
    update() {
      if (!this.gameRunning) return;
      
      // Update road lines
      this.roadLines.forEach(line => {
        line.y -= this.gameSpeed * 2;
        if (line.y < -50) {
          line.y = this.canvas.height + 50;
        }
      });
      
      // Update ocean waves
      this.oceanWaves.forEach(wave => {
        wave.y -= this.gameSpeed;
        if (wave.y < -40) {
          wave.y = this.canvas.height + 40;
          wave.x = Math.random() * (this.canvas.width * 0.3);
        }
      });
      
      // Update landscape elements
      this.landscapeElements.forEach(element => {
        element.y -= this.gameSpeed * 1.5;
        if (element.y < -80) {
          element.y = this.canvas.height + 80;
          element.x = this.canvas.width * 0.7 + Math.random() * (this.canvas.width * 0.3);
        }
      });
      
      // Update obstacles
      this.obstacles.forEach((obstacle, index) => {
        obstacle.y -= obstacle.speed;
        
        // Remove obstacles that are off screen
        if (obstacle.y < -100) {
          this.obstacles.splice(index, 1);
        }
        
        // Check collision with player
        if (this.checkCollision(this.player, obstacle)) {
          this.obstacles.splice(index, 1);
          this.startCrashAnimation();
          this.lives--;
          document.getElementById('lives')!.textContent = this.lives.toString();
          
          if (this.lives <= 0) {
            this.gameOver();
          }
        }
      });
      
      // Update seals
      this.seals.forEach((seal, index) => {
        seal.y -= seal.speed;
        
        // Remove seals that are off screen
        if (seal.y < -60) {
          this.seals.splice(index, 1);
        }
        
        // Check collision with player
        if (this.checkCollision(this.player, seal)) {
          this.seals.splice(index, 1);
          this.score += 10;
          document.getElementById('score')!.textContent = this.score.toString();
        }
      });
      
      // Update game time for animations
      this.gameTime += 0.1;
      
      // Update player smooth movement and bobbing
      if (this.player.targetX !== undefined) {
        this.player.x += (this.player.targetX - this.player.x) * this.player.moveSpeed;
      }
      this.player.bobOffset = Math.sin(this.gameTime * 0.8) * 1.5; // Engine rumble bobbing
      
      // Update particles
      this.particles.forEach((particle, index) => {
        particle.x += particle.vx;
        particle.y += particle.vy;
        particle.life--;
        particle.alpha = particle.life / particle.maxLife;
        
        if (particle.life <= 0) {
          this.particles.splice(index, 1);
        }
      });
      
      // Add exhaust particles
      if (Math.random() < 0.3) {
        this.addExhaustParticle();
      }
      
      // Update crash animation
      if (this.crashAnimation) {
        this.crashAnimation.timer--;
        if (this.crashAnimation.timer <= 0) {
          this.crashAnimation = null;
        }
      }
      
      // Increase game speed over time
      this.gameSpeed += 0.001;
    }
    
    checkCollision(rect1, rect2) {
      return rect1.x < rect2.x + rect2.width &&
             rect1.x + rect1.width > rect2.x &&
             rect1.y < rect2.y + rect2.height &&
             rect1.y + rect1.height > rect2.y;
    }
    
    draw() {
      // Clear canvas
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      
      // Draw ocean (left 30% of screen)
      const gradient = this.ctx.createLinearGradient(0, 0, this.canvas.width * 0.3, 0);
      gradient.addColorStop(0, '#1E3A8A');
      gradient.addColorStop(0.5, '#3B82F6');
      gradient.addColorStop(1, '#60A5FA');
      this.ctx.fillStyle = gradient;
      this.ctx.fillRect(0, 0, this.canvas.width * 0.3, this.canvas.height);
      
      // Draw ocean waves
      this.ctx.fillStyle = '#FFFFFF';
      this.oceanWaves.forEach(wave => {
        this.ctx.globalAlpha = 0.6;
        this.ctx.beginPath();
        for (let x = 0; x < this.canvas.width * 0.3; x += 5) {
          const y = wave.y + Math.sin((x + wave.x) * wave.frequency) * wave.amplitude;
          if (x === 0) {
            this.ctx.moveTo(x, y);
          } else {
            this.ctx.lineTo(x, y);
          }
        }
        this.ctx.stroke();
        this.ctx.globalAlpha = 1;
      });
      
      // Draw road (middle 40% of screen)
      this.ctx.fillStyle = '#404040';
      this.ctx.fillRect(this.canvas.width * 0.3, 0, this.canvas.width * 0.4, this.canvas.height);
      
      // Draw landscape (right 30% of screen)
      const landscapeGradient = this.ctx.createLinearGradient(this.canvas.width * 0.7, 0, this.canvas.width, 0);
      landscapeGradient.addColorStop(0, '#16A34A');
      landscapeGradient.addColorStop(0.5, '#22C55E');
      landscapeGradient.addColorStop(1, '#4ADE80');
      this.ctx.fillStyle = landscapeGradient;
      this.ctx.fillRect(this.canvas.width * 0.7, 0, this.canvas.width * 0.3, this.canvas.height);
      
      // Draw landscape elements
      this.landscapeElements.forEach(element => {
        if (element.type === 'tree') {
          this.drawTree(element.x, element.y, element.size);
        } else {
          this.drawHill(element.x, element.y, element.size);
        }
      });
      
      // Draw road lines (center of road)
      this.ctx.fillStyle = '#FFD700';
      this.roadLines.forEach(line => {
        const newX = this.canvas.width * 0.5 - 2; // Center the road lines
        this.ctx.fillRect(newX, line.y, line.width, line.height);
      });
      
      // Draw lane dividers
      this.ctx.fillStyle = '#FFFFFF';
      const roadWidth = this.canvas.width * 0.4;
      const roadStart = this.canvas.width * 0.3;
      const laneWidth = roadWidth / 3;
      for (let i = 1; i < 3; i++) {
        const x = roadStart + (i * laneWidth) - 1;
        this.ctx.fillRect(x, 0, 2, this.canvas.height);
      }
      
      // Draw particles first (behind car)
      this.drawParticles();
      
      // Draw player car with faces (with crash effect if needed)
      const carX = this.player.x;
      const carY = this.player.y + this.player.bobOffset; // Add bobbing animation
      
      if (this.crashAnimation) {
        this.drawCarWithFaces(carX + (Math.random() - 0.5) * 10, carY + (Math.random() - 0.5) * 10, this.player.width, this.player.height, '#FF0000');
        
        // Draw crash effects
        this.ctx.fillStyle = '#FFD700';
        for (let i = 0; i < 8; i++) {
          const angle = (i / 8) * Math.PI * 2;
          const x = carX + this.player.width/2 + Math.cos(angle) * 30;
          const y = carY + this.player.height/2 + Math.sin(angle) * 30;
          this.ctx.beginPath();
          this.ctx.ellipse(x, y, 3, 3, 0, 0, 2 * Math.PI);
          this.ctx.fill();
        }
        
        // Flash effect
        this.ctx.fillStyle = `rgba(255, 255, 255, ${0.3 + Math.random() * 0.4})`;
        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
      } else {
        this.drawCarWithFaces(carX, carY, this.player.width, this.player.height, '#FF6B6B');
      }
      
      // Draw obstacles
      this.obstacles.forEach(obstacle => {
        let color = '#8B4513'; // brown for rocks
        if (obstacle.type === 'car') color = '#4169E1'; // blue for cars
        if (obstacle.type === 'cop') color = '#000000'; // black for cops
        
        if (obstacle.type === 'rock') {
          this.drawRock(obstacle.x, obstacle.y, obstacle.width, obstacle.height);
        } else if (obstacle.type === 'cop') {
          this.drawCopCar(obstacle.x, obstacle.y, obstacle.width, obstacle.height);
        } else {
          this.drawCar(obstacle.x, obstacle.y, obstacle.width, obstacle.height, color);
        }
      });
      
      // Draw seals
      this.seals.forEach(seal => {
        this.drawSeal(seal.x, seal.y, seal.width, seal.height);
      });
      
      // Draw game title in landscape area
      this.drawGameTitle();
    }
    
    drawCar(x, y, width, height, color) {
      this.ctx.fillStyle = color;
      this.ctx.fillRect(x, y, width, height);
      
      // Car details
      this.ctx.fillStyle = '#87CEEB';
      this.ctx.fillRect(x + 5, y + 10, width - 10, height - 30);
      
      // Wheels
      this.ctx.fillStyle = '#000000';
      this.ctx.fillRect(x - 5, y + 15, 10, 15);
      this.ctx.fillRect(x + width - 5, y + 15, 10, 15);
      this.ctx.fillRect(x - 5, y + height - 30, 10, 15);
      this.ctx.fillRect(x + width - 5, y + height - 30, 10, 15);
    }
    
    drawRock(x, y, width, height) {
      // Main rock shape (stable, not randomly generated each frame)
      this.ctx.fillStyle = '#696969'; // Dark gray rock color
      this.ctx.beginPath();
      
      // Create stable irregular rock shape (using position as seed for consistency)
      const centerX = x + width/2;
      const centerY = y + height/2;
      const seed = (x + y) % 100; // Use position as seed for consistent shape
      
      // Pre-defined rock shape variations based on seed
      const rockType = Math.floor(seed / 25); // 4 different rock types
      
      if (rockType === 0) {
        // Boulder type - more round
        this.ctx.ellipse(centerX, centerY, width/2 * 0.9, height/2 * 0.8, 0.1, 0, 2 * Math.PI);
      } else if (rockType === 1) {
        // Jagged type - angular
        this.ctx.moveTo(x + width * 0.2, y);
        this.ctx.lineTo(x + width * 0.8, y + height * 0.1);
        this.ctx.lineTo(x + width, y + height * 0.4);
        this.ctx.lineTo(x + width * 0.9, y + height);
        this.ctx.lineTo(x + width * 0.3, y + height * 0.9);
        this.ctx.lineTo(x, y + height * 0.6);
        this.ctx.closePath();
      } else if (rockType === 2) {
        // Oval type - stretched
        this.ctx.ellipse(centerX, centerY, width/2 * 1.1, height/2 * 0.6, 0.3, 0, 2 * Math.PI);
      } else {
        // Irregular type - bumpy
        this.ctx.moveTo(x + width * 0.1, y + height * 0.3);
        this.ctx.lineTo(x + width * 0.4, y);
        this.ctx.lineTo(x + width * 0.7, y + height * 0.1);
        this.ctx.lineTo(x + width, y + height * 0.3);
        this.ctx.lineTo(x + width * 0.9, y + height * 0.7);
        this.ctx.lineTo(x + width * 0.6, y + height);
        this.ctx.lineTo(x + width * 0.2, y + height * 0.8);
        this.ctx.lineTo(x, y + height * 0.5);
        this.ctx.closePath();
      }
      this.ctx.fill();
      
      // Rock highlights (lighter areas) - stable positions
      this.ctx.fillStyle = '#808080';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/3, y + height/4, width/6, height/8, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      if (width > 35) { // Only add detail if rock is big enough
        this.ctx.beginPath();
        this.ctx.ellipse(x + 2*width/3, y + height/3, width/8, height/6, 0, 0, 2 * Math.PI);
        this.ctx.fill();
      }
      
      // Rock shadows/cracks (darker areas) - stable positions
      this.ctx.fillStyle = '#4A4A4A';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2, y + 2*height/3, width/5, height/8, 0, 0, 2 * Math.PI);
      this.ctx.fill();
    }
    
    drawSeal(x, y, width, height) {
      // Cute seal that actually looks like a seal!
      
      // Seal body (torpedo-shaped like real seals)
      this.ctx.fillStyle = '#696969'; // Gray seal color
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2, y + height/2 + 5, width/2 - 1, height/2.5, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Seal belly (lighter gray)
      this.ctx.fillStyle = '#A9A9A9';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2, y + height/2 + 8, width/3.5, height/4, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Seal head (rounder but realistic)
      this.ctx.fillStyle = '#696969';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2, y + height/3, width/2.5, height/3, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Seal snout/muzzle
      this.ctx.fillStyle = '#808080';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2, y + height/3 + 3, width/4, height/6, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Rear flippers (like real seals)
      this.ctx.fillStyle = '#5D5D5D';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2 - 8, y + height - 6, 4, 6, -0.5, 0, 2 * Math.PI);
      this.ctx.fill();
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2 + 8, y + height - 6, 4, 6, 0.5, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Front flippers (smaller, like real seals)
      this.ctx.fillStyle = '#5D5D5D';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/4, y + height/2 + 2, 3, 5, -0.3, 0, 2 * Math.PI);
      this.ctx.fill();
      this.ctx.beginPath();
      this.ctx.ellipse(x + 3*width/4, y + height/2 + 2, 3, 5, 0.3, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Large cute eyes (seals have big eyes!)
      this.ctx.fillStyle = '#000000';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2 - 6, y + height/3 - 2, 3, 4, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2 + 6, y + height/3 - 2, 3, 4, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Eye sparkles for cuteness
      this.ctx.fillStyle = '#FFFFFF';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2 - 5, y + height/3 - 3, 1, 1, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2 + 7, y + height/3 - 3, 1, 1, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Seal nose (small black nose)
      this.ctx.fillStyle = '#000000';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2, y + height/3 + 4, 1.5, 1, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Seal whiskers (important seal feature!)
      this.ctx.strokeStyle = '#000000';
      this.ctx.lineWidth = 1;
      this.ctx.beginPath();
      this.ctx.moveTo(x + width/2 - 8, y + height/3 + 2);
      this.ctx.lineTo(x + width/2 - 14, y + height/3 + 1);
      this.ctx.moveTo(x + width/2 + 8, y + height/3 + 2);
      this.ctx.lineTo(x + width/2 + 14, y + height/3 + 1);
      this.ctx.moveTo(x + width/2 - 8, y + height/3 + 5);
      this.ctx.lineTo(x + width/2 - 14, y + height/3 + 4);
      this.ctx.moveTo(x + width/2 + 8, y + height/3 + 5);
      this.ctx.lineTo(x + width/2 + 14, y + height/3 + 4);
      this.ctx.stroke();
      
      // Seal spots (many seals have spots)
      this.ctx.fillStyle = '#5D5D5D';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2 - 5, y + height/2 + 3, 2, 1.5, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2 + 7, y + height/2 + 8, 1.5, 1, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/2 + 2, y + height/2 - 2, 1, 1, 0, 0, 2 * Math.PI);
      this.ctx.fill();
    }
    
    drawCarWithFaces(x, y, width, height, color) {
      this.ctx.fillStyle = color;
      this.ctx.fillRect(x, y, width, height);
      
      // Car windshield
      this.ctx.fillStyle = '#87CEEB';
      this.ctx.fillRect(x + 5, y + 10, width - 10, height - 30);
      
      // Boy face (left side - driver)
      this.ctx.fillStyle = '#FDBCB4'; // Skin tone
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/4, y + height/3, 8, 10, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Boy eyes
      this.ctx.fillStyle = '#000000';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/4 - 3, y + height/3 - 2, 1, 1, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/4 + 3, y + height/3 - 2, 1, 1, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Boy hair
      this.ctx.fillStyle = '#8B4513';
      this.ctx.beginPath();
      this.ctx.ellipse(x + width/4, y + height/3 - 8, 9, 6, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Boy smile
      this.ctx.strokeStyle = '#000000';
      this.ctx.lineWidth = 1;
      this.ctx.beginPath();
      this.ctx.arc(x + width/4, y + height/3 + 2, 3, 0, Math.PI);
      this.ctx.stroke();
      
      // Girl face (right side - passenger)
      this.ctx.fillStyle = '#FDBCB4'; // Skin tone
      this.ctx.beginPath();
      this.ctx.ellipse(x + 3*width/4, y + height/3, 8, 10, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Girl eyes
      this.ctx.fillStyle = '#000000';
      this.ctx.beginPath();
      this.ctx.ellipse(x + 3*width/4 - 3, y + height/3 - 2, 1, 1, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      this.ctx.beginPath();
      this.ctx.ellipse(x + 3*width/4 + 3, y + height/3 - 2, 1, 1, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Girl hair (longer)
      this.ctx.fillStyle = '#DAA520';
      this.ctx.beginPath();
      this.ctx.ellipse(x + 3*width/4, y + height/3 - 8, 10, 8, 0, 0, 2 * Math.PI);
      this.ctx.fill();
      
      // Girl smile
      this.ctx.strokeStyle = '#000000';
      this.ctx.lineWidth = 1;
      this.ctx.beginPath();
      this.ctx.arc(x + 3*width/4, y + height/3 + 2, 3, 0, Math.PI);
      this.ctx.stroke();
      
      // Wheels
      this.ctx.fillStyle = '#000000';
      this.ctx.fillRect(x - 5, y + 15, 10, 15);
      this.ctx.fillRect(x + width - 5, y + 15, 10, 15);
      this.ctx.fillRect(x - 5, y + height - 30, 10, 15);
      this.ctx.fillRect(x + width - 5, y + height - 30, 10, 15);
    }
    
    drawTree(x, y, size) {
      // Tree trunk
      this.ctx.fillStyle = '#8B4513';
      this.ctx.fillRect(x - size/8, y + size/2, size/4, size/2);
      
      // Tree foliage
      this.ctx.fillStyle = '#228B22';
      this.ctx.beginPath();
      this.ctx.ellipse(x, y + size/3, size/2, size/2, 0, 0, 2 * Math.PI);
      this.ctx.fill();
    }
    
    drawHill(x, y, size) {
      this.ctx.fillStyle = '#32CD32';
      this.ctx.beginPath();
      this.ctx.ellipse(x, y + size/2, size, size/3, 0, 0, 2 * Math.PI);
      this.ctx.fill();
    }
    
    drawCopCar(x, y, width, height) {
      // Police car body (black and white)
      this.ctx.fillStyle = '#000000';
      this.ctx.fillRect(x, y, width, height);
      
      // White police stripe
      this.ctx.fillStyle = '#FFFFFF';
      this.ctx.fillRect(x, y + height/3, width, height/3);
      
      // Car windshield
      this.ctx.fillStyle = '#87CEEB';
      this.ctx.fillRect(x + 5, y + 10, width - 10, height - 30);
      
      // Police text
      this.ctx.fillStyle = '#0000FF';
      this.ctx.font = 'bold 8px Arial';
      this.ctx.textAlign = 'center';
      this.ctx.fillText('POLICE', x + width/2, y + height/2 + 2);
      
      // Flashing lights effect
      const lightColor = Math.random() > 0.5 ? '#FF0000' : '#0000FF';
      this.ctx.fillStyle = lightColor;
      this.ctx.fillRect(x + 5, y + 5, 8, 4);
      this.ctx.fillRect(x + width - 13, y + 5, 8, 4);
      
      // Wheels
      this.ctx.fillStyle = '#000000';
      this.ctx.fillRect(x - 5, y + 15, 10, 15);
      this.ctx.fillRect(x + width - 5, y + 15, 10, 15);
      this.ctx.fillRect(x - 5, y + height - 30, 10, 15);
      this.ctx.fillRect(x + width - 5, y + height - 30, 10, 15);
    }
    
    drawParticles() {
      this.particles.forEach(particle => {
        this.ctx.save();
        this.ctx.globalAlpha = particle.alpha;
        this.ctx.fillStyle = particle.color;
        this.ctx.beginPath();
        this.ctx.ellipse(particle.x, particle.y, particle.size, particle.size, 0, 0, 2 * Math.PI);
        this.ctx.fill();
        this.ctx.restore();
      });
    }
    
    addExhaustParticle() {
      // Add exhaust particles from the back of the car (going down/away from car)
      this.particles.push({
        x: this.player.x + this.player.width/2 + (Math.random() - 0.5) * 15,
        y: this.player.y + this.player.height + 2,
        vx: (Math.random() - 0.5) * 1,
        vy: -(Math.random() * 2 + 1), // Negative velocity to go down/away from car 
        size: Math.random() * 2 + 1,
        life: 20 + Math.random() * 15,
        maxLife: 35,
        alpha: 1,
        color: Math.random() > 0.6 ? '#D3D3D3' : '#A9A9A9' // Gray exhaust
      });
    }
    
    drawGameTitle() {
      // Draw title in the landscape (grass) area on the right
      this.ctx.save();
      
      const titleX = this.canvas.width - 20;
      const titleY = 40;
      
      // Draw background box for better readability
      this.ctx.fillStyle = 'rgba(0, 0, 0, 0.7)'; // Semi-transparent black background
      this.ctx.fillRect(this.canvas.width * 0.7 + 10, titleY - 25, this.canvas.width * 0.3 - 20, 180);
      
      // Draw border for the box
      this.ctx.strokeStyle = '#FFD700';
      this.ctx.lineWidth = 2;
      this.ctx.strokeRect(this.canvas.width * 0.7 + 10, titleY - 25, this.canvas.width * 0.3 - 20, 180);
      
      // Set up text styling for a cool retro look with better contrast
      this.ctx.fillStyle = '#FFD700'; // Bright gold for main title
      this.ctx.strokeStyle = '#000000'; // Black outline for contrast
      this.ctx.lineWidth = 3;
      this.ctx.font = 'bold 22px Impact, Arial Black, sans-serif';
      this.ctx.textAlign = 'right';
      
      // Add stronger text shadow effect
      this.ctx.shadowColor = 'rgba(0, 0, 0, 0.8)';
      this.ctx.shadowOffsetX = 3;
      this.ctx.shadowOffsetY = 3;
      this.ctx.shadowBlur = 5;
      
      // Draw main title with outline
      this.ctx.strokeText('CALIFORNIA', titleX, titleY);
      this.ctx.fillText('CALIFORNIA', titleX, titleY);
      
      this.ctx.strokeText('ROADTRIP:', titleX, titleY + 26);
      this.ctx.fillText('ROADTRIP:', titleX, titleY + 26);
      
      // Make "REMASTERED" smaller but still visible
      this.ctx.font = 'bold 16px Impact, Arial Black, sans-serif';
      this.ctx.fillStyle = '#FFA500'; // Orange for contrast
      this.ctx.lineWidth = 2;
      this.ctx.strokeText('REMASTERED', titleX, titleY + 48);
      this.ctx.fillText('REMASTERED', titleX, titleY + 48);
      
      // Add quick rules overview with better contrast
      this.ctx.shadowOffsetX = 2;
      this.ctx.shadowOffsetY = 2;
      this.ctx.shadowBlur = 3;
      this.ctx.font = 'bold 12px Arial, sans-serif';
      this.ctx.fillStyle = '#FFFFFF'; // White text for maximum contrast
      this.ctx.strokeStyle = '#000000'; // Black outline
      this.ctx.lineWidth = 2;
      
      const rulesY = titleY + 75;
      this.ctx.strokeText('🦭 COLLECT SEALS', titleX, rulesY);
      this.ctx.fillText('🦭 COLLECT SEALS', titleX, rulesY);
      
      this.ctx.strokeText('🚗 DODGE OBSTACLES', titleX, rulesY + 18);
      this.ctx.fillText('🚗 DODGE OBSTACLES', titleX, rulesY + 18);
      
      this.ctx.strokeText('👮 AVOID POLICE', titleX, rulesY + 36);
      this.ctx.fillText('👮 AVOID POLICE', titleX, rulesY + 36);
      
      this.ctx.strokeText('❤️ 3 LIVES', titleX, rulesY + 54);
      this.ctx.fillText('❤️ 3 LIVES', titleX, rulesY + 54);
      
      // Add controls instruction
      this.ctx.font = 'bold 10px Arial, sans-serif';
      this.ctx.fillStyle = '#FFFF99'; // Light yellow
      this.ctx.strokeText('← → KEYS / SWIPE', titleX, rulesY + 75);
      this.ctx.fillText('← → KEYS / SWIPE', titleX, rulesY + 75);
      
      this.ctx.restore();
    }
    
    startCrashAnimation() {
      this.crashAnimation = {
        timer: 30 // 30 frames of animation
      };
    }
    
    gameOver() {
      this.gameRunning = false;
      document.getElementById('final-score')!.textContent = this.score.toString();
      document.getElementById('game-over')!.classList.remove('hidden');
    }
    
    restart() {
      this.score = 0;
      this.lives = 3;
      this.gameRunning = true;
      this.gameSpeed = 2;
      this.obstacles = [];
      this.seals = [];
      this.crashAnimation = null;
      this.gameTime = 0;
      this.particles = [];
      
      this.setupPlayer();
      
      document.getElementById('score')!.textContent = '0';
      document.getElementById('lives')!.textContent = '3';
      document.getElementById('game-over')!.classList.add('hidden');
    }
    
    gameLoop() {
      this.update();
      this.draw();
      
      if (this.gameRunning) {
        requestAnimationFrame(() => this.gameLoop());
      }
    }
  }
  
  // Start the game when page loads
  document.addEventListener('DOMContentLoaded', () => {
    new CoastalRoadTripGame();
  });
</script>

<style>
  body {
    margin: 0;
    padding: 0;
    overflow: hidden;
  }
  
  #gameCanvas {
    display: block;
    touch-action: none;
  }
</style>