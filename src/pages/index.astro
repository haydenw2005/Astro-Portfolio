---
import '@/styles/global.css';
import LightLayout from '../layouts/LightLayout.astro';
---

<LightLayout title="Me" metaTitle="Hayden" description="sci-fi, mobile agents, etc." image="/images/space-banner.jpeg">
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="resume-page">
    <div class="hero-frame">
      <img class="hero-banner" src="/images/space-banner.jpeg" alt="Painted orbital landscape banner" />
    </div>
    <div class="image-peel">
      <img
        class="collage-image collage-main"
        src="/images/space-banner.jpeg"
        alt="Painted orbital landscape banner"
      />
      <img
        class="collage-image collage-hari"
        src="/images/print-hari.jpg"
        alt="Illustration of Hari Seldon in a futuristic city"
      />
      <img
        class="collage-image collage-cylinder"
        src="/images/space-collage-2.jpg"
        alt="Illustrated O'Neill cylinder habitat"
      />
      <figure class="collage-quote">
        <blockquote>Not only the world as it is, but the world as it will be.</blockquote>
        <figcaption>Isaac Asimov</figcaption>
      </figure>
    </div>

    <div class="resume-shell">
      <div class="left-column">
        <header class="intro">
          <div class="type-lockup">
            <h1><span>Hayden</span> <span>White</span></h1>
          </div>
          <nav aria-label="Contact links">
            <a href="mailto:hayden@revyl.ai" aria-label="Email Hayden">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 6h16v12H4z" />
                <path d="m4 7 8 6 8-6" />
              </svg>
            </a>
            <a href="https://github.com/haydenw2005" target="_blank" aria-label="Hayden on GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.75a9.25 9.25 0 0 0-2.93 18.03c.46.08.63-.2.63-.44v-1.63c-2.57.56-3.11-1.1-3.11-1.1-.42-1.06-1.03-1.34-1.03-1.34-.84-.57.06-.56.06-.56.93.07 1.42.96 1.42.96.82 1.41 2.16 1 2.69.77.08-.59.32-1 .58-1.23-2.05-.23-4.2-1.02-4.2-4.56 0-1.01.36-1.83.95-2.47-.1-.23-.41-1.17.09-2.44 0 0 .78-.25 2.55.94a8.8 8.8 0 0 1 4.64 0c1.77-1.19 2.55-.94 2.55-.94.5 1.27.19 2.21.09 2.44.59.64.95 1.46.95 2.47 0 3.55-2.16 4.32-4.22 4.55.33.29.63.86.63 1.73v2.56c0 .25.17.53.64.44A9.25 9.25 0 0 0 12 2.75Z" />
              </svg>
            </a>
            <a href="https://www.linkedin.com/in/hayden-s-white/" target="_blank" aria-label="Hayden on LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6.94 8.93V19H3.7V8.93h3.24ZM5.33 4a1.88 1.88 0 1 1 0 3.76 1.88 1.88 0 0 1 0-3.76Zm7.01 4.93.1 1.44c.69-1.07 1.72-1.69 3.14-1.69 2.28 0 4.02 1.52 4.02 4.78V19h-3.25v-5.07c0-1.59-.58-2.42-1.77-2.42-1.08 0-1.76.72-1.99 1.42-.08.25-.1.61-.1.96V19H9.24V8.93h3.1Z" />
              </svg>
            </a>
            <a href="https://www.instagram.com/haydensw_/" target="_blank" aria-label="Hayden on Instagram">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="4" y="4" width="16" height="16" rx="4.5" />
                <circle cx="12" cy="12" r="3.6" />
                <circle cx="16.8" cy="7.2" r="0.8" />
              </svg>
            </a>
            <a href="https://x.com/hxxwhite" target="_blank" aria-label="Hayden on X">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 4h4.5l3.9 5.25L17.15 4H20l-6.25 6.9L20.6 20h-4.5l-4.3-5.75L6.6 20H3.75l6.7-7.4L4 4Zm3.45 1.55 9.45 12.9h1.25L8.7 5.55H7.45Z" />
              </svg>
            </a>
            <button class="orbit-dial" type="button" aria-label="Reveal banner image">
              <img src="/favicon.png" alt="" />
            </button>
          </nav>
          <p class="bio">
            Currently a founding engineer at <a href="https://revyl.com/" target="_blank"><strong>Revyl</strong></a>, I
            built our Mac infrastructure, designed core product surfaces, and architected our mobile-use agent. Before
            that, I built GTM prospecting agents and agentic trading terminals for prediction markets. I studied
            systems, AI, and math at Purdue before dropping out.
            <br /><br />
            I'm obsessed with sci-fi, optimization, and <span class="bio-highlight">leverage</span>.
          </p>
        </header>

      </div>

      <!-- <aside class="books" aria-label="Books Hayden loves">
        <h2>Books I Love</h2>
        <div class="book-list">
          <article class="book">
            <img src="/images/books/foundation.jpg" alt="Foundation by Isaac Asimov" loading="lazy" />
            <div>
              <strong>Foundation</strong>
              <p>Isaac Asimov</p>
            </div>
          </article>
          <article class="book">
            <img src="/images/books/exhalation.jpg" alt="Exhalation by Ted Chiang" loading="lazy" />
            <div>
              <strong>Exhalation</strong>
              <p>Ted Chiang</p>
            </div>
          </article>
          <article class="book">
            <img src="/images/books/prisoners-of-geography.jpg" alt="Prisoners of Geography by Tim Marshall" loading="lazy" />
            <div>
              <strong>Prisoners of Geography</strong>
              <p>Tim Marshall</p>
            </div>
          </article>
          <article class="book">
            <img src="/images/books/snow-crash.jpg" alt="Snow Crash by Neal Stephenson" loading="lazy" />
            <div>
              <strong>Snow Crash</strong>
              <p>Neal Stephenson</p>
            </div>
          </article>
        </div>
      </aside> -->
    </div>

  </main>

  <script is:inline>
    const orbitDial = document.querySelector('.orbit-dial');
    let dialBoost = 0;
    let dialDecayTimer;

    orbitDial?.addEventListener('click', () => {
      dialBoost = Math.min(dialBoost + 0.11, 0.64);
      orbitDial.style.setProperty('--dial-click-scale', String(1 + dialBoost));

      window.clearTimeout(dialDecayTimer);
      dialDecayTimer = window.setTimeout(() => {
        dialBoost = 0;
        orbitDial.style.setProperty('--dial-click-scale', '1');
      }, 150);
    });
  </script>
</LightLayout>

<style>
  :global(.light-page) {
    background:
      radial-gradient(rgba(31, 31, 29, 0.035) 0.7px, transparent 0.7px) 0 0 / 4px 4px,
      radial-gradient(rgba(31, 31, 29, 0.025) 0.6px, transparent 0.6px) 2px 2px / 5px 5px,
      #fbfaf7;
  }

  :global(html),
  :global(body) {
    overflow-x: hidden;
   }

  .resume-page {
    --content-inset: clamp(52px, 6vw, 92px);
    min-height: 100vh;
    overflow-x: hidden;
    color: #1f1f1d;
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .hero-frame {
    position: relative;
    width: 100%;
    height: 40vh;
    min-height: 280px;
    overflow: hidden;
    border-bottom: 1px solid rgba(31, 31, 29, 0.08);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.5), 0 14px 26px rgba(68, 58, 44, 0.07);
  }

  .hero-frame::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 46px;
    background:
      linear-gradient(to bottom, rgba(251, 250, 247, 0) 0%, rgba(251, 250, 247, 0.5) 62%, #fbfaf7 100%),
      radial-gradient(ellipse at 38% 100%, rgba(251, 250, 247, 0.64), rgba(251, 250, 247, 0) 62%);
    pointer-events: none;
  }

  .hero-banner {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 64%;
  }

  .image-peel {
    display: none;
  }

  .collage-image,
  .collage-quote {
    display: none;
  }

  .resume-shell {
    display: grid;
    grid-template-columns: minmax(0, 1240px);
    align-items: start;
    width: min(1240px, calc(100vw - var(--content-inset) - 48px));
    min-height: 60vh;
    margin: 0 auto 0 var(--content-inset);
    padding: var(--content-inset) 0 34px;
  }

  .left-column {
    grid-column: 1;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 800px);
    row-gap: 26px;
    max-width: 1240px;
  }

  .type-lockup {
    width: min(800px, 100%);
  }

  h1 {
    margin: 0;
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: clamp(4rem, 6.05vw, 5.72rem);
    line-height: 0.82;
    font-weight: 650;
    letter-spacing: -0.065em;
  }

  h1 span {
    display: inline;
  }

  nav {
    --origin: 36px;
    --button: 48px;
    --ring-1: 91px;
    --ring-2: 189px;
    --ring-3: 352px;
    position: fixed;
    right: 0;
    bottom: 0;
    z-index: 20;
    width: min(42vw, 448px);
    height: min(42vw, 448px);
    background:
      radial-gradient(
        circle at calc(100% - var(--origin)) calc(100% - var(--origin)),
        transparent 0 calc(var(--ring-1) - 1px),
        rgba(31, 31, 29, 0.24) calc(var(--ring-1) - 1px) var(--ring-1),
        transparent var(--ring-1) calc(var(--ring-2) - 1px),
        rgba(31, 31, 29, 0.22) calc(var(--ring-2) - 1px) var(--ring-2),
        transparent var(--ring-2) calc(var(--ring-3) - 1px),
        rgba(31, 31, 29, 0.2) calc(var(--ring-3) - 1px) var(--ring-3),
        transparent var(--ring-3)
      );
  }

  nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        circle at calc(100% - var(--origin)) calc(100% - var(--origin)),
        transparent 0 calc(var(--ring-1) - 1px),
        rgba(157, 111, 19, 0.36) calc(var(--ring-1) - 1px) var(--ring-1),
        transparent var(--ring-1) calc(var(--ring-2) - 1px),
        rgba(157, 111, 19, 0.28) calc(var(--ring-2) - 1px) var(--ring-2),
        transparent var(--ring-2) calc(var(--ring-3) - 1px),
        rgba(157, 111, 19, 0.22) calc(var(--ring-3) - 1px) var(--ring-3),
        transparent var(--ring-3)
      );
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .orbit-dial {
    --dial-img-scale: 0.82;
    --dial-click-scale: 1;
    position: absolute;
    right: calc(var(--origin) - 18px);
    bottom: calc(var(--origin) - 18px);
    z-index: 2;
    width: 36px;
    height: 36px;
    padding: 4px;
    border: 0;
    border-radius: 999px;
    background: rgba(251, 250, 247, 0.9);
    box-shadow: 0 0 0 8px rgba(31, 31, 29, 0.045), inset 0 0 0 1px rgba(31, 31, 29, 0.18);
    cursor: pointer;
    overflow: hidden;
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease,
      transform 145ms cubic-bezier(0.2, 0.9, 0.2, 1.28),
      width 180ms ease,
      height 180ms ease,
      right 180ms ease,
      bottom 180ms ease;
  }

  .orbit-dial img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(var(--dial-img-scale)) rotate(0deg);
    transition: filter 140ms ease, transform 210ms cubic-bezier(0.2, 0.9, 0.2, 1.18);
  }

  nav:has(a:is(:hover, :focus-visible)) .orbit-dial,
  .orbit-dial:hover,
  .orbit-dial:focus-visible {
    --dial-img-scale: 0.76;
    right: calc(var(--origin) - 22px);
    bottom: calc(var(--origin) - 22px);
    width: 44px;
    height: 44px;
    background: rgba(251, 250, 247, 0.96);
    box-shadow: 0 0 0 9px rgba(31, 31, 29, 0.05), 0 0 0 21px rgba(157, 111, 19, 0.1);
    transform: scale(calc(var(--dial-click-scale) * 1.04));
    outline: none;
  }

  .orbit-dial:active {
    transform: scale(calc(var(--dial-click-scale) * 1.11));
  }

  nav:has(a:is(:hover, :focus-visible)) .orbit-dial img,
  .orbit-dial:hover img,
  .orbit-dial:focus-visible img {
    filter: contrast(1.05);
    transform: scale(var(--dial-img-scale)) rotate(180deg);
  }

  nav:has(a:is(:hover, :focus-visible))::before {
    opacity: 1;
  }

  nav:has(.orbit-dial:is(:hover, :focus-visible)) {
    background: transparent;
  }

  nav:has(.orbit-dial:is(:hover, :focus-visible))::before,
  nav:has(.orbit-dial:is(:hover, :focus-visible)) a {
    opacity: 0;
    pointer-events: none;
  }

  .bio {
    grid-column: 1;
    max-width: 710px;
    margin-top: 0;
    color: #35332f;
    font-size: clamp(1rem, 1.15vw, 1.12rem);
    line-height: 1.6;
    letter-spacing: -0.01em;
  }

  .bio-highlight {
    color: #9d6f13;
    font-weight: 700;
  }

  .books {
    grid-column: 2;
  }

  a {
    color: #111;
    text-decoration: underline;
    text-decoration-color: rgba(31, 31, 29, 0.28);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 150ms ease, color 150ms ease;
  }

  a:hover {
    color: #000;
    text-decoration-color: #9d6f13;
  }

  nav a {
    --orbit-x: 0px;
    --orbit-y: 0px;
    --hover-x: 0px;
    --hover-y: 0px;
    position: absolute;
    z-index: 1;
    right: calc(var(--origin) - (var(--button) / 2));
    bottom: calc(var(--origin) - (var(--button) / 2));
    display: inline-grid;
    place-items: center;
    width: var(--button);
    height: var(--button);
    border: 1px solid rgba(31, 31, 29, 0.24);
    border-radius: 999px;
    background: rgba(251, 250, 247, 0.84);
    backdrop-filter: blur(8px);
    color: #2a2925;
    text-decoration: none;
    overflow: hidden;
    transform: translate(var(--orbit-x), var(--orbit-y));
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      box-shadow 150ms ease,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  nav a::before {
    content: '';
    position: absolute;
    inset: -7px;
    border-radius: 999px;
    border: 1px solid rgba(190, 148, 70, 0);
    transform: scale(0.72);
    transition: border-color 150ms ease, transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  nav a::after {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: 999px;
    background:
      radial-gradient(ellipse at 34% 28%, rgba(255, 255, 255, 0.95) 0 18%, transparent 42%),
      linear-gradient(118deg, transparent 0 36%, rgba(255, 255, 255, 0.5) 44%, rgba(157, 111, 19, 0.16) 52%, transparent 66%),
      radial-gradient(circle at 50% 50%, rgba(249, 245, 235, 0.92), rgba(232, 219, 189, 0.62) 72%);
    filter: blur(0.15px);
    opacity: 0;
    transform: rotate(-10deg) scale(0.9);
    transition:
      opacity 180ms ease,
      transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  nav a:nth-child(1) {
    --orbit-x: -109px;
    --orbit-y: -335px;
  }

  nav a:nth-child(2) {
    --orbit-x: -89px;
    --orbit-y: -167px;
  }

  nav a:nth-child(3) {
    --orbit-x: -66px;
    --orbit-y: -63px;
  }

  nav a:nth-child(4) {
    --orbit-x: -178px;
    --orbit-y: -65px;
  }

  nav a:nth-child(5) {
    --orbit-x: -257px;
    --orbit-y: -241px;
  }

  nav a:hover,
  nav a:focus-visible {
    background: rgba(249, 245, 235, 0.92);
    border-color: rgba(157, 111, 19, 0.55);
    box-shadow: 0 10px 22px rgba(31, 31, 29, 0.14), 0 0 0 8px rgba(157, 111, 19, 0.12);
    color: #1f1f1d;
    outline: none;
    animation: social-node-pulse 680ms cubic-bezier(0.2, 0.8, 0.2, 1);
    transform: translate(var(--orbit-x), var(--orbit-y)) scale(1.08);
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    opacity: 1;
    transform: rotate(18deg) scale(1);
  }

  nav a:hover svg,
  nav a:focus-visible svg {
    animation: social-icon-kick 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  nav a:hover::before,
  nav a:focus-visible::before {
    border-color: rgba(157, 111, 19, 0.45);
    transform: scale(1);
  }

  @keyframes social-node-pulse {
    0% {
      box-shadow: 0 10px 22px rgba(31, 31, 29, 0.1), 0 0 0 0 rgba(157, 111, 19, 0);
    }
    55% {
      box-shadow: 0 12px 24px rgba(31, 31, 29, 0.15), 0 0 0 10px rgba(157, 111, 19, 0.12);
    }
    100% {
      box-shadow: 0 10px 22px rgba(31, 31, 29, 0.14), 0 0 0 7px rgba(157, 111, 19, 0.1);
    }
  }

  @keyframes social-icon-kick {
    0% {
      transform: scale(1) rotate(0deg);
    }
    45% {
      transform: scale(1.14) rotate(-5deg);
    }
    100% {
      transform: scale(1) rotate(0deg);
    }
  }

  nav svg {
    position: relative;
    z-index: 1;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  nav a:nth-child(2) svg,
  nav a:nth-child(3) svg,
  nav a:nth-child(5) svg {
    fill: currentColor;
    stroke: none;
  }

  @media (min-width: 821px) {
    .image-peel {
      position: fixed;
      inset: 0;
      z-index: 15;
      display: grid;
      grid-template-columns: minmax(260px, 0.34fr) minmax(0, 0.66fr);
      grid-template-rows: minmax(0, 0.54fr) minmax(0, 0.46fr);
      grid-template-areas:
        'hari main'
        'hari cylinder';
      gap: clamp(8px, 0.9vw, 14px);
      padding: clamp(8px, 0.9vw, 14px);
      background: #fbfaf7;
      clip-path: circle(0 at calc(100% - 36px) calc(100% - 36px));
      opacity: 0;
      pointer-events: none;
      transform: scale(1.018);
      transform-origin: 100% 100%;
      will-change: clip-path, opacity, transform;
      transition:
        clip-path 980ms cubic-bezier(0.16, 1, 0.3, 1),
        opacity 980ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 980ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .collage-image,
    .collage-quote {
      display: block;
    }

    .collage-image {
      position: relative;
      width: 100%;
      height: 100%;
      min-width: 0;
      min-height: 0;
      border: 0;
      background: rgba(251, 250, 247, 0.12);
      box-shadow: none;
      object-fit: cover;
      opacity: 0;
      filter: saturate(0.92) contrast(1.04);
      transition:
        opacity 640ms ease,
        transform 1100ms cubic-bezier(0.16, 1, 0.3, 1),
        filter 900ms ease;
    }

    .collage-main {
      grid-area: main;
      object-position: center 62%;
      transform: translate(34px, -26px) scale(0.97);
      transition-delay: 80ms;
    }

    .collage-hari {
      grid-area: hari;
      object-position: center top;
      transform: translate(-28px, 24px) scale(0.97);
      transition-delay: 30ms;
    }

    .collage-cylinder {
      grid-area: cylinder;
      object-position: center center;
      transform: translate(34px, 28px) scale(0.97);
      transition-delay: 150ms;
    }

    .collage-quote {
      position: absolute;
      top: clamp(34px, 6vh, 78px);
      left: clamp(32px, 4vw, 72px);
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: start;
      max-width: min(27vw, 430px);
      margin: 0;
      padding: clamp(14px, 1.5vw, 22px) clamp(16px, 1.7vw, 24px);
      border: 0;
      background:
        linear-gradient(135deg, rgba(20, 19, 17, 0.58), rgba(20, 19, 17, 0.24));
      backdrop-filter: blur(2px);
      color: #fbfaf7;
      opacity: 0;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.72), 0 8px 38px rgba(0, 0, 0, 0.54);
      transform: translate(0, -18px);
      transition:
        opacity 520ms ease 120ms,
        transform 860ms cubic-bezier(0.16, 1, 0.3, 1) 120ms;
    }

    .collage-quote blockquote {
      margin: 0;
      color: inherit;
      font-size: clamp(1.3rem, 1.9vw, 2.25rem);
      font-weight: 600;
      line-height: 1.06;
      letter-spacing: -0.045em;
    }

    .collage-quote figcaption {
      margin-top: 12px;
      color: rgba(251, 250, 247, 0.72);
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .resume-page:has(.orbit-dial:is(:hover, :focus-visible)) .image-peel {
      clip-path: circle(150vmax at calc(100% - 36px) calc(100% - 36px));
      opacity: 1;
      transform: scale(1);
    }

    .resume-page:has(.orbit-dial:is(:hover, :focus-visible)) .collage-image,
    .resume-page:has(.orbit-dial:is(:hover, :focus-visible)) .collage-quote {
      opacity: 1;
    }

    .resume-page:has(.orbit-dial:is(:hover, :focus-visible)) .collage-main {
      transform: translate(0, 0) scale(1);
