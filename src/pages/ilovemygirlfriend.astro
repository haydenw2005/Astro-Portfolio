---
import LilliePortfolio from '../components/LilliePortfolio';
import Layout from '../layouts/Layout.astro';
---

<Layout title="ily bae" description="A special place for the most amazing girlfriend in the world">
  <link slot="head" rel="icon" type="image/png" href="/images/Lillie/mozart.png" />
  <main class="min-h-screen">
    <LilliePortfolio client:load />
  </main>
</Layout>

<style>
  main {
    background-color: #fdfcfb;
    background-image: 
      radial-gradient(ellipse at 30% 20%, rgba(255, 182, 193, 0.08) 0%, transparent 40%),
      radial-gradient(ellipse at 70% 40%, rgba(135, 206, 250, 0.08) 0%, transparent 40%),
      radial-gradient(ellipse at 10% 60%, rgba(135, 206, 250, 0.06) 0%, transparent 50%),
      radial-gradient(ellipse at 90% 80%, rgba(255, 192, 203, 0.06) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 50%, rgba(255, 182, 193, 0.04) 0%, transparent 60%),
      radial-gradient(ellipse at 20% 90%, rgba(135, 206, 250, 0.05) 0%, transparent 40%),
      radial-gradient(ellipse at 80% 10%, rgba(255, 192, 203, 0.05) 0%, transparent 40%);
    background-size: 100% 100%;
    background-attachment: fixed;
  }
</style> 